{
	"name": "commonground",
	"version": "0.1.0",
	"description": "WebXR CommonGround library with room-aware scene placement and persistence",
	"private": true,
	"type": "module",
	"main": "index.js",
	"module": "index.js",
	"bin": {
		"commonground": "cli.js"
	},
	"exports": {
		".": "./index.js",
		"./server": "./server/index.js",
		"./dashboard": "./dashboard/index.js",
		"./package.json": "./package.json"
	},
	"files": [
		"index.js",
		"cli.js",
		"src",
		"server",
		"dashboard",
		"examples",
		"assets",
		"README.md"
	],
	"devDependencies": {
		"@babel/core": "^7.28.4",
		"@babel/preset-env": "^7.28.3",
		"babel-loader": "8.2.5",
		"concurrently": "5.3.0",
		"css-loader": "^5.2.1",
		"html-webpack-plugin": "^5.3.1",
		"nodemon": "^3.1.10",
		"pre-commit": "^1.2.2",
		"style-loader": "^2.0.0",
		"webpack": "^5.33.2",
		"webpack-cli": "^4.6.0",
		"webpack-dev-server": "^4.11.1"
	},
	"scripts": {
		"build": "node scripts/run-webpack.js build",
		"serve": "node scripts/run-webpack.js serve",
		"server": "node server/server.js",
		"server:transient": "COMMONGROUND_LOG_CLEAR_SECONDS=4 node server/server.js",
		"server:transient:force": "COMMONGROUND_LOG_CLEAR_SECONDS=4 COMMONGROUND_LOG_CLEAR_FORCE=1 node server/server.js",
		"server:clean": "lsof -nP -iTCP:3001 -sTCP:LISTEN | awk 'NR>1 {print $2}' | xargs -I{} kill {} 2>/dev/null; node server/server.js",
		"dev:nobuild": "npm run server",
		"dev": "concurrently \"npm run serve\" \"npm run server\"",
		"start": "npm run dev"
	},
	"dependencies": {
		"compression": "^1.8.1",
		"cors": "^2.8.5",
		"express": "^4.21.2",
		"node-fetch": "^3.3.2",
		"ratk": "^0.3.0",
		"selfsigned": "^3.0.1",
		"socket.io": "^4.8.3",
		"three": "npm:super-three@0.158.0",
		"troika-three-text": "0.49.0"
	}
}
